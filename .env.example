# Informed — environment variable template (NO real secrets in this file).
# The running app is the Next.js project in frontend/. Copy the values you need
# into frontend/.env.local (gitignored). Restart the dev server after changes.

# --- Supabase (required) -----------------------------------------------------
# Browser-exposed (NEXT_PUBLIC_*). The anon key must be the *publishable* key
# (sb_publishable_...), which is safe to ship to the client. RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key-here

# --- Google Civic Information API (optional; powers /api/elections) ----------
# SERVER-SIDE ONLY — note there is no NEXT_PUBLIC_ prefix, so this key never
# reaches the browser. Without it, the elections screen falls back to labeled
# sample data. Get a free key: https://console.cloud.google.com/ (enable the
# "Google Civic Information API", then create an API key).
GOOGLE_CIVIC_API_KEY=your-google-civic-key-here

# --- Other data sources (server-side; not wired up yet) ----------------------
GOVTRACK_API_KEY=optional-for-rate-limiting
OPENSECRETS_API_KEY=your-opensecrets-key-here

# --- Claude API (server-side; for future AI summaries) -----------------------
CLAUDE_API_KEY=your-claude-api-key-here

# --- Backend (not built yet; backend/ is currently empty) --------------------
NODE_ENV=development
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
